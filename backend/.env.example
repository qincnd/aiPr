# 复制为 backend/.env 后按需修改；所有变量都带 AIPR_ 前缀。

# ---------- 服务 ----------
AIPR_HOST=127.0.0.1
AIPR_PORT=8000
AIPR_DEBUG=false

# ---------- 素材目录白名单 ----------
# 前端只能扫描这些目录（多个用 ; 分隔，Windows）
AIPR_MEDIA_ROOTS=E:\project\python\aiPr\media;%USERPROFILE%\Videos;%USERPROFILE%\Desktop
# ffprobe 路径，留空则自动从 PATH 查找（装了 ffmpeg 就能读到真实时长/分辨率）
# AIPR_FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
AIPR_MAX_MEDIA_FILES=2000

# ---------- Premiere 后端 ----------
# mock = 内置模拟时间线（不需要装 PR）；pymiere = 真实驱动本机 Premiere Pro
AIPR_PREMIERE_BACKEND=mock
# 真实后端可选：要打开/保存的工程文件
# AIPR_PREMIERE_PROJECT_PATH=D:\projects\demo.prproj

# ---------- 大模型（任何 OpenAI 兼容接口） ----------
AIPR_LLM_ENABLED=true
AIPR_LLM_BASE_URL=https://api.deepseek.com/v1
AIPR_LLM_API_KEY=
AIPR_LLM_MODEL=deepseek-chat
AIPR_LLM_TIMEOUT_SECONDS=120
AIPR_LLM_TEMPERATURE=0.2
